<Page x:Class="AdsService.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdsService"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Страница авторизации">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин:" FontSize="14" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="16" Grid.Column="0" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
        <TextBlock Text="Пароль:" FontSize="14" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="16" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>

        <TextBox x:Name="loginTextBox" FontSize="14" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="38" Width="150" VerticalContentAlignment="Center" Margin="16" Grid.Column="1" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <PasswordBox x:Name="passwordPassBox" FontSize="14" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="38" Width="150" VerticalContentAlignment="Center" Margin="16" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" />

        <Button x:Name="BtAuth" Content="Войти" FontSize="14" FontFamily="Tw Cen MT" Foreground="#FF37474F" Background="#FFFF9C1A" Padding="10" Height="38" Width="150" Margin="16" Click="BtAuth_Click" Grid.Column="1" Grid.Row="2" VerticalAlignment="Top"/>
        <Button x:Name="BtViewProduct" Content="Страница товаров" FontSize="14" FontFamily="Tw Cen MT" Foreground="#FF37474F" Background="#FF78909C" Padding="10" Height="38"  Width="150" Margin="16" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Click="BtViewProduct_Click" />

    </Grid>
</Page>
