<Page x:Class="AdsService.AddAdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AdsService"
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Добавление или редактирование объявления">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="91*"/>
            <ColumnDefinition Width="309*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="titleTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBlock Text="Описание:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="descTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBlock Text="Город:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="cityComboBox" SelectedValuePath="id" SelectedValue="{Binding Path=city_name}" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30"  Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="2" Padding="10"/>

        <TextBlock Text="Категория:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="categoryComboBox" SelectedValuePath="id" SelectedValue="{Binding Path=category_name}" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30"  Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="3" Padding="10"/>

        <TextBlock Text="Тип:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="typeComboBox" SelectedValuePath="id" SelectedValue="{Binding Path=type_name}" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30"  Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="4" Padding="10"/>

        <TextBlock Text="Статус:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="statusComboBox" SelectedValuePath="id" SelectedValue="{Binding Path=status_name}" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30"  Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="5" Padding="10"/>

        <TextBlock Text="Цена:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="priceTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <TextBlock Text="Путь к картинке:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="imagesTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="7" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Button x:Name="BtSave" Content="Сохранить" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Background="#FFFF9C1A" Padding="5" Height="30" Width="150" Margin="10" Grid.Column="1" Grid.Row="8" VerticalAlignment="Center" Click="BtSave_Click"/>
        <Button x:Name="BtClear" Content="Очистить" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Background="#FF78909C" Padding="5" Height="30"  Width="150" Margin="10" Grid.Column="0" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Right" Click="BtClear_Click"/>

    </Grid>
</Page>
