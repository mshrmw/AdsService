<Page x:Class="AdsService.AddAdPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="500" d:DesignWidth="800"
      Title="Добавление или редактирование объявления">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="titleTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding ad_title}"/>

        <TextBlock Text="Описание:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="descTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="60" Width="500"  TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="10" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding ad_description}"/>

        <TextBlock Text="Город:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="cityComboBox" DisplayMemberPath="city_name" SelectedValuePath="id" SelectedValue="{Binding id_city}" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10" Grid.Column="1" Grid.Row="3" Padding="10"/>

        <TextBlock Text="Категория:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="categoryComboBox" DisplayMemberPath="category_name" SelectedValuePath="id" SelectedValue="{Binding id_category}" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10" Grid.Column="1" Grid.Row="4" Padding="10"/>

        <TextBlock Text="Тип:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="typeComboBox" DisplayMemberPath="type_name" SelectedValuePath="id" SelectedValue="{Binding id_type}" FontSize="12" FontFamily="Tw Cen MT"  Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10" Grid.Column="1" Grid.Row="5" Padding="10"/>

        <TextBlock Text="Статус:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <ComboBox x:Name="statusComboBox" DisplayMemberPath="status_name" SelectedValuePath="id" SelectedValue="{Binding id_status}" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10" Grid.Column="1" Grid.Row="6" Padding="10"/>

        <TextBlock x:Name="completedPriceTextBlock" Text="Фактическая цена:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="9" VerticalAlignment="Center"  HorizontalAlignment="Right" Visibility="Collapsed"/>
        <TextBox x:Name="completedPriceTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="10" Grid.Column="1" Grid.Row="9" Padding="10" Visibility="Collapsed"/>

        <TextBlock Text="Цена:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="7" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="priceTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="7" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding ad_price}"/>

        <TextBlock Text="Путь к картинке:" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Padding="10" Margin="10" Grid.Column="0" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <TextBox x:Name="imagesTextBox" FontSize="12" FontFamily="Tw Cen MT" Foreground="#FF37474F" Height="30" Width="500" VerticalContentAlignment="Center" Margin="10" Grid.Column="1" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding ad_images}"/>

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="BtSave" Content="Сохранить" FontSize="12" FontFamily="Tw Cen MT" Foreground="White" Background="#FFFF9C1A" Padding="10,5" Height="35" Width="120" Margin="10" Click="BtSave_Click"/>
            <Button x:Name="BtClear" Content="Очистить" FontSize="12" FontFamily="Tw Cen MT"  Foreground="White" Background="#FF78909C" Padding="10,5" Height="35" Width="120" Margin="10" Click="BtClear_Click"/>
        </StackPanel>
    </Grid>
</Page>